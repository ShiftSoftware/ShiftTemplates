<Project>
	<!-- The licence files travel inside every package. -->
	<ItemGroup Condition="'$(MSBuildProjectName)' == 'ShiftTemplates'">
		<None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)LICENSING.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
