@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using ShiftSoftware.ShiftIdentity.Core.Authentication
@using ShiftSoftware.ShiftIdentity.Blazor.Services
@using ShiftSoftware.ShiftIdentity.Dashboard.Blazor.Pages.Auth
@using ShiftSoftware.ShiftIdentity.Dashboard.Blazor.Pages.UserManager
@using ShiftSoftware.ShiftIdentity.Dashboard.Blazor.Shared
@using System.Net.Http.Json
@using ShiftSoftware.ShiftIdentity.Core.DTOs
@namespace StockPlusPlus.API.Development.IdentityPreview
@inject IdentityPreviewState Preview
@inject AuthenticationFlow Flow
@inject ShiftSoftware.ShiftIdentity.Blazor.IdentitySession Store
@inject HttpClient Http
@inject Microsoft.Extensions.Hosting.IHostApplicationLifetime Lifetime
@implements IDisposable

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<main style="max-width:1100px;margin:32px auto;padding:0 20px">
    <h1 style="font-size:28px;margin-bottom:12px">StockPlusPlus authentication preview</h1>
    <MudAlert Severity="Severity.Info">Local synthetic accounts · disposable SQL · isolated session storage</MudAlert>
    <p style="margin:16px 0">Initial password for every account: <strong>@Preview.Password</strong>. Your chosen replacement remains in this disposable database until the preview stops.</p>
    <ul>
        @foreach (var account in IdentityPreviewState.Accounts)
        {
            <li><strong>@account.Username</strong> — @account.Label</li>
        }
    </ul>
    <p style="margin:16px 0">
        <label for="code-account">Show the active authenticator for: </label>
        <select id="code-account" value="@codeAccount" @onchange="SelectCodeAccount">
            @foreach (var account in IdentityPreviewState.Accounts)
            { <option value="@account.Username">@account.Username</option> }
        </select>
    </p>
    <DevelopmentAuthenticatorCodes @ref="codes" LoadCodes="LoadCodes" ContextKey="CodeContext" />
    <p>New authenticator codes appear during setup. You can also scan the QR code with your authenticator app.</p>
    <p>Each code can be accepted once per account. After sign-in, wait for the next code before proving the existing authenticator for replacement. A cancelled replacement keeps the old authenticator active.</p>
    <p>Mandatory MFA: <strong>@(Preview.Mandatory ? "enabled" : "optional")</strong>.
        <MudButton OnClick="ToggleMandatory" Variant="Variant.Outlined" Disabled="Flow.Busy">@(Preview.Mandatory ? "Make MFA optional" : "Require MFA for local login")</MudButton>
        Changing this synthetic policy ends this journey and invalidates existing preview sessions. Use preview-mandatory to try required enrollment.
    </p>
    <p>For lost-device recovery, sign in as preview-admin. After confirming the person's identity through your team's procedure, record a support ticket or short note. <strong>DEMO-CHECK-001</strong> is only an example audit reference; Shift does not verify its truth. Copy the separately generated recovery code and share it privately. Choose Try another login, then Use an admin recovery code with preview-recovery, its current password, and that code. Confirm the new authenticator; recovery returns to login without a session.</p>
    @if (configuringMfa)
    {
        <TotpEnrollmentForm AdmissionFlow="Flow" AdmissionCompleted="SecurityCompleted" />
    }
    else if (changing)
    {
        <ChangePasswordForm AdmissionFlow="Flow" AdmissionCompleted="SecurityCompleted" />
        <MudButton OnClick="CancelChange" Variant="Variant.Outlined">Cancel password change</MudButton>
    }
    else if (issued is not null)
    {
        <MudAlert Severity="Severity.Success" data-testid="session-issued">
            Session issued for @issued.Session.UserData.Username. Access expires in @issued.Session.TokenLifeTimeInSeconds seconds.
            Credentials are held only in this preview circuit.
        </MudAlert>
        <MudButton OnClick="StartChange" Variant="Variant.Outlined" Color="Color.Primary">Change password</MudButton>
        <MudButton OnClick="StartMfa" Variant="Variant.Outlined" Color="Color.Primary">@(hasFactor ? "Replace authenticator" : "Set up authenticator")</MudButton>
        <MudButton OnClick="RenewCurrent" Variant="Variant.Outlined" Disabled="renewing">Renew current session</MudButton>
        <MudButton OnClick="Restart" Variant="Variant.Filled" Color="Color.Primary">Try another login</MudButton>
        @if (issued.Session.UserData.Username == "preview-admin")
        {
            <h2 style="margin-top:20px">Recovery for preview-recovery</h2>
            <MfaRecoveryAdminForm AdmissionFlow="Flow" AccessToken="@issued.Session.Token" UserID="recoveryUserID" />
        }
    }
    else
    {
        <LoginForm @key="formVersion" AdmissionFlow="Flow" SessionCompleted="Completed" />
        @if (Flow.Pending is { Handle: null, Step: not AuthenticationStep.MfaRecovery } restricted)
        {
            <MudAlert Severity="Severity.Warning" data-testid="preview-restricted">
                Restricted: @restricted.Step. This remedy remains unavailable in the preview; no session was stored.
            </MudAlert>
        }
    }
    @if (previous is not null)
    {
        <MudButton OnClick="RenewPrevious" Variant="Variant.Outlined" Disabled="renewing">Try previous session renewal</MudButton>
    }
    @if (resultText is not null)
    {
        <MudAlert Severity="Severity.Info" data-testid="preview-result">@resultText</MudAlert>
    }
    <hr style="margin:24px 0" />
    <p>Sessions stay in this preview only. Stop preview shuts down the local host and removes its temporary database.</p>
    <MudButton OnClick="Stop" Color="Color.Error" Variant="Variant.Outlined">Stop preview</MudButton>
</main>

@code {
    private SessionIssued? issued;
    private TokenDTO? previous;
    private bool changing;
    private bool configuringMfa;
    private bool hasFactor;
    private long recoveryUserID;
    private bool renewing;
    private int journeyVersion;
    private string? resultText;
    private int formVersion;
    private string codeAccount = "preview-mfa";
    private DevelopmentAuthenticatorCodes? codes;
    private string CodeContext() => codeAccount + ":" + Flow.Pending?.NewAuthenticator?.Secret;
    private Task<AuthenticatorCodeSnapshot> LoadCodes(CancellationToken cancellation) =>
        Preview.CodeSnapshotAsync(codeAccount, Flow.Pending?.NewAuthenticator?.Secret, cancellation);
    private Task RefreshCode() => codes?.RefreshAsync() ?? Task.CompletedTask;
    private async Task SelectCodeAccount(ChangeEventArgs args)
    {
        var selected = args.Value?.ToString();
        if (IdentityPreviewState.Accounts.Any(x => x.Username == selected)) codeAccount = selected!;
        await RefreshCode();
    }
    protected override async Task OnInitializedAsync()
    {
        recoveryUserID = (await Preview.FactorAsync("preview-recovery")).UserID;
    }
    private async Task Completed(SessionIssued result)
    {
        journeyVersion++;
        issued = result;
        codeAccount = result.Session.UserData.Username;
        hasFactor = (await Preview.FactorAsync(codeAccount)).Code is not null;
        if (Flow.PasswordWasChanged || Flow.MfaWasChanged) resultText = "Security change completed. The initiating session uses the new security version.";
        await RefreshCode();
    }
    private async Task StartChange()
    {
        if (issued is null) return;
        journeyVersion++;
        previous = issued.Session;
        var result = await Flow.BeginPasswordChangeAsync(issued.Session.Token);
        changing = result is ChallengeRequired;
        resultText = changing ? "Confirm your current password, then complete any MFA before choosing a new password."
            : "The signed-in context is no longer current. Sign in again.";
    }
    private async Task StartMfa()
    {
        if (issued is null) return;
        journeyVersion++;
        previous = issued.Session;
        var result = await Flow.BeginMfaAsync(issued.Session.Token, hasFactor);
        configuringMfa = result is ChallengeRequired;
        resultText = configuringMfa ? null : "The setup could not start. Sign in again.";
        await RefreshCode();
    }
    private async Task SecurityCompleted(AuthOutcome result)
    {
        var continuation = result switch { PasswordChanged p => p.Continuation, MfaChanged m => m.Continuation, _ => result };
        if (continuation is SessionIssued session)
        {
            changing = false; configuringMfa = false; await Completed(session);
        }
        else if (result is OperationCancelled)
        {
            changing = false; configuringMfa = false;
            resultText = "Setup cancelled. The active credential is unchanged.";
        }
        else if (Flow.Pending is null && result is AuthenticationRefused)
        {
            changing = false; configuringMfa = false;
            resultText = "The change could not be confirmed. Sign in again to check; a lost response can follow a completed change.";
        }
        await RefreshCode();
    }
    private async Task ToggleMandatory()
    {
        await Restart();
        await Preview.SetMandatoryAsync(!Preview.Mandatory);
        resultText = "Preview policy changed. Sign in again to begin a new journey.";
    }
    private async Task CancelChange()
    {
        journeyVersion++;
        var result = await Flow.CancelAsync(); changing = false;
        resultText = result is OperationCancelled ? "Password-change operation cancelled."
            : "Cancellation was not confirmed. If completion was already in progress, sign in again to check the password.";
    }
    private Task RenewPrevious() => Renew(previous, false);
    private Task RenewCurrent() => Renew(issued?.Session, true);
    private async Task Renew(TokenDTO? token, bool current)
    {
        if (token is null || renewing) return;
        renewing = true;
        var requestVersion = journeyVersion;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/identity/v2/refresh", new RenewSessionRequest(token.RefreshToken));
            var result = await response.Content.ReadFromJsonAsync<AuthOutcome>();
            if (requestVersion != journeyVersion) return;
            resultText = $"{(current ? "Current" : "Previous")} session renewal: " + (result switch
            {
                SessionIssued => "accepted.", AuthenticationRefused refused => $"refused ({refused.Code}).",
                ChallengeRequired challenge => $"restricted ({challenge.Challenge.Step}).", _ => "unavailable."
            });
            if (current && !changing && !configuringMfa && ReferenceEquals(issued?.Session, token) && result is SessionIssued session && response.IsSuccessStatusCode)
            { issued = session; await Store.StoreTokenAsync(session.Session); }
        }
        catch (Exception e) when (e is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException)
        { if (requestVersion == journeyVersion) resultText = "Renewal could not be confirmed."; }
        finally { renewing = false; }
    }
    private async Task Restart()
    {
        journeyVersion++;
        await Flow.CancelAsync();
        await Store.RemoveTokenAsync();
        issued = null;
        previous = null; changing = false; configuringMfa = false; resultText = null;
        formVersion++;
        await RefreshCode();
    }
    private void Stop() => Lifetime.StopApplication();
    public void Dispose() => Flow.Restart();
}
