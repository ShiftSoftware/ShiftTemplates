  "ListSql": "SELECT CONVERT(varchar(20), [i].[ID]), [i].[ManualReference], [i].[InvoiceNo], [i].[IsDeleted], [i].[ID], [s].[Description], [s].[Price], [s].[Name], [s].[Price0], [s].[c], [s].[Name0], [s].[ID], [s].[ID0], [s].[ID1]\r\nFROM [Invoices] AS [i]\r\nLEFT JOIN (\r\n    SELECT [i0].[Description], [i0].[Price], [p].[Name], [p].[Price] AS [Price0], CAST(0 AS bit) AS [c], [b].[Name] AS [Name0], [i0].[ID], [p].[ID] AS [ID0], [b].[ID] AS [ID1], [i0].[InvoiceID]\r\n    FROM [InvoiceLines] AS [i0]\r\n    INNER JOIN [Products] AS [p] ON [i0].[ProductID] = [p].[ID]\r\n    INNER JOIN [Brands] AS [b] ON [p].[ProductBrandID] = [b].[ID]\r\n) AS [s] ON [i].[ID] = [s].[InvoiceID]\r\nORDER BY [i].[ID], [s].[ID], [s].[ID0]",
