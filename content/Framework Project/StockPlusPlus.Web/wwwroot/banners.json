{
  // Rules for <ShiftBanners /> (see Pages/Banners/README.md). Paths are glob patterns matched against
  // the page path; include/exclude are condition names that BannerLayout's IsConditionMet decides.
  "rules": [
    {
      "id": "invoice-editors",
      "paths": [ "/InvoiceList", "/InvoiceForm/**" ],
      "include": [ "can-write:Invoice" ],
      "severity": "Warning",
      "message": {
        "en": "Sample banner (wwwroot/banners.json): shown on the invoice pages to users who can edit invoices.",
        "ar": "شريط تنبيه تجريبي (wwwroot/banners.json): يظهر في صفحات الفواتير للمستخدمين الذين يمكنهم تعديل الفواتير.",
        "ku": "بانەری نموونە (wwwroot/banners.json): لە پەڕەکانی پسووڵەدا بۆ ئەو بەکارهێنەرانە پیشان دەدرێت کە دەتوانن دەستکاری پسووڵە بکەن."
      }
    },
    {
      "id": "product-viewers",
      "paths": [ "/ProductList", "/ProductForm/**" ],
      "exclude": [ "can-write:Product" ],
      "severity": "Info",
      "message": {
        "en": "Sample banner (wwwroot/banners.json): shown on the product pages only to users who cannot edit products.",
        "ar": "شريط تنبيه تجريبي (wwwroot/banners.json): يظهر في صفحات المنتجات فقط للمستخدمين الذين لا يمكنهم تعديل المنتجات."
      }
    },
    {
      "id": "development-build",
      "paths": [ "/**" ],
      "include": [ "development" ],
      "severity": "Normal",
      "message": {
        "en": "Development build: banners on this page come from wwwroot/banners.json."
      }
    }
  ]
}
