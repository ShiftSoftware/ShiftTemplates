@attribute [Route($"/{nameof(ProductBrandForm)}/{{Key?}}")]

@using StockPlusPlus.Shared.DTOs.ProductBrand
@*#if (includeItemTemplateContent)*@
@using StockPlusPlus.Shared.Enums
@*#endif*@

<ShiftEntityForm T="ProductBrandDTO"
                 AllowSaveAsNew
                 Endpoint="ProductBrand"
                 Title="ProductBrand"
                 BaseUrlKey="StockPluPlus"
                 @bind-Value="BrandItem"
                 TypeAuthAction="StockPlusPlus.Shared.ActionTrees.StockPlusPlusActionTree.ProductBrand"
                 @bind-Key="@Key">
    @*#if (includeItemTemplateContent)*@
    <MudTabs Elevation="0" ApplyEffectsToContainer @bind-ActivePanelIndex="NameLayoutIndex">
        @foreach (var option in Enum.GetValues<LanguageLayout>())
        {
            <MudTabPanel Text="@option.ToString()" />
        }
    </MudTabs>

    @* Re-created on each layout change so the new layout loads the current Name. *@
    <LocalizedTextField @key="NameLayout"
                        @bind-Value="context.Item.Name"
                        For="() => context.Item.Name"
                        Languages="NameLanguages"
                        LanguageLayout="NameLayout"
                        Label="Name" />

    <MudTextFieldExtended OnlyValidateIfDirty="true"
                          Label="Code"
                          @bind-Value="context.Item.Code"
                          For="@(() => context.Item.Code)" />

    <ShiftAutocomplete Label="Assigned Team"
                       @bind-Value="context.Item.Team"
                       TEntitySet="ShiftSoftware.ShiftIdentity.Core.DTOs.Team.TeamListDTO"
                       EntitySet="IdentityTeam"
                       For="() => context.Item.Team" />

    @if (context.Mode == FormModes.View && !context.Embedded)
    {
        <br />
        <br />

        <ProductList ProductBrandID="@context.Item.ID" />
    }
    @*#endif*@
</ShiftEntityForm>

@code {
    // Every generated form needs Key and BrandItem for the bindings above.
    // Only the sample-specific members belong inside the template condition.
    [Parameter]
    public object? Key { get; set; }

    private ProductBrandDTO BrandItem = new ProductBrandDTO();

    @*#if (includeItemTemplateContent)*@
    [Parameter]
    [SupplyParameterFromQuery]
    public string? BrandName { get; set; }

    private static readonly List<LanguageInfo> NameLanguages =
    [
        new() { CultureName = "en-US", Label = "English" },
        new() { CultureName = "ar-IQ", Label = "Arabic", RTL = true },
        new() { CultureName = "ku-IQ", Label = "Kurdish", RTL = true },
        new() { CultureName = "fr-FR", Label = "French" },
        new() { CultureName = "tr-TR", Label = "Turkish" },
    ];

    private int NameLayoutIndex;
    private LanguageLayout NameLayout => (LanguageLayout)NameLayoutIndex;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(BrandName))
        {
            BrandItem.Name = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
            {
                ["en"] = BrandName,
                ["ar"] = BrandName,
                ["ku"] = BrandName
            });
        }
    }
    @*#endif*@
}
