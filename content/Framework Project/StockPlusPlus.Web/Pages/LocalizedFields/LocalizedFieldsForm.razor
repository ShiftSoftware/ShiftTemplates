@attribute [Route($"/{nameof(LocalizedFieldsForm)}")]
@using System.ComponentModel.DataAnnotations
@inject ISnackbar Snackbar

<ShiftFormBasic Value="Item" Title="Localized fields" OnValidSubmit="Saved">
    <MudTabsExtended Elevation="0" ApplyEffectsToContainer TabPanelsClass="pt-6">
        @foreach (var sample in Samples)
        {
            <MudTabPanel Text="@sample.Layout.ToString()">
                <FormSection For="@sample.Layout.ToString()">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">@sample.Description</MudText>

                    <LocalizedTextField Label="@sample.Layout.ToString()"
                                        Value="@sample.Get(context.Item)"
                                        ValueChanged="@(value => sample.Set(context.Item, value))"
                                        For="@sample.For(context.Item)"
                                        Languages="Languages"
                                        LanguageLayout="sample.Layout" />

                    <MudText Typo="Typo.caption" Class="d-block mt-6">Stored value</MudText>
                    <code style="word-break: break-all;">@(sample.Get(context.Item) ?? "—")</code>
                </FormSection>
            </MudTabPanel>
        }
    </MudTabsExtended>
</ShiftFormBasic>

@code {
    private static readonly List<LanguageInfo> Languages =
    [
        new() { CultureName = "en-US", Label = "English" },
        new() { CultureName = "ar-IQ", Label = "Arabic", RTL = true },
        new() { CultureName = "ku-IQ", Label = "Kurdish", RTL = true },
        new() { CultureName = "fr-FR", Label = "French" },
        new() { CultureName = "tr-TR", Label = "Turkish" },
    ];

    private static readonly List<LayoutSample> Samples =
    [
        new(LanguageLayout.Grid, "The default: one input per language in a grid that wraps onto new rows.",
            x => x.Grid, (x, v) => x.Grid = v, x => () => x.Grid),
        new(LanguageLayout.Row, "One input per language on a single row. It scrolls sideways when the inputs don't fit.",
            x => x.Row, (x, v) => x.Row = v, x => () => x.Row),
        new(LanguageLayout.Stacked, "One full-width input per language, one under the other.",
            x => x.Stacked, (x, v) => x.Stacked = v, x => () => x.Stacked),
        new(LanguageLayout.Dropdown, "One input with a language dropdown. The dropdown marks languages with text or errors.",
            x => x.Dropdown, (x, v) => x.Dropdown = v, x => () => x.Dropdown),
        new(LanguageLayout.Tabs, "One input with a tab per language. Each tab marks text or errors.",
            x => x.Tabs, (x, v) => x.Tabs = v, x => () => x.Tabs),
        new(LanguageLayout.Expandable, "The first language's input, with the other languages behind the +N button.",
            x => x.Expandable, (x, v) => x.Expandable = v, x => () => x.Expandable),
    ];

    private LocalizedFieldsSample Item = new();

    private void Saved() => Snackbar.Add("Every language is filled in.", Severity.Success);

    private record LayoutSample(
        LanguageLayout Layout,
        string Description,
        Func<LocalizedFieldsSample, string?> Get,
        Action<LocalizedFieldsSample, string> Set,
        Func<LocalizedFieldsSample, System.Linq.Expressions.Expression<Func<string?>>> For);

    public class LocalizedFieldsSample
    {
        [Required] public string? Grid { get; set; }
        [Required] public string? Row { get; set; }
        [Required] public string? Stacked { get; set; }
        [Required] public string? Dropdown { get; set; }
        [Required] public string? Tabs { get; set; }
        [Required] public string? Expandable { get; set; }
    }
}
